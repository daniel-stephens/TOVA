# TOVA environment file
#
# Copy this to .env in the project root and fill in the values marked REQUIRED:
#
#     cp sample.env .env
#
# .env is read by both `make` and `docker compose`, so a few rules apply to
# every value: no spaces around "=", no quotes, and no "#" or "$" characters
# (make treats "#" as a comment and compose treats "$" as a variable).
#
# After changing anything here, restart the stack: make down && make up

##############
# Image tags #
##############
# Leave as latest unless your team publishes versioned images.
VERSION=latest
ASSETS_DATE=latest

##############
# Host ports #
##############
# Ports opened on the host machine. The containers always listen on 11000 (api)
# and 8080 (web) internally; change these only if the ports are already taken.
API_PORT=11000
WEB_PORT=8080
# Only used for the URL printed when the stack starts.
HOST=0.0.0.0

###############
# Environment #
###############
ENV=development

############
# Postgres #
############
# REQUIRED. All three must stay the same once the database has been created.
# To change them later you must wipe the database first (make reset-db), which
# deletes all study data.
POSTGRES_USER=tova_user
POSTGRES_PASSWORD=choose-a-strong-password
POSTGRES_DB=tova_db

##########
# Django #
##########
# REQUIRED. A long random string. Generate one with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string

# true shows detailed error pages. Never true on a server participants can reach.
DJANGO_DEBUG=false

# Hostnames the site answers to, comma separated. * accepts any host; on a
# public server set it to your domain, e.g. tova.example.org
DJANGO_ALLOWED_HOSTS=*

# Needed when the site is served from a domain or behind a proxy, otherwise form
# submissions fail with a CSRF error. Full origins, comma separated, e.g.
# https://tova.example.org
CSRF_TRUSTED_ORIGINS=

# Set true when the site is served over HTTPS, so login cookies are only sent
# over encrypted connections. Leave false for plain http://localhost.
USE_HTTPS=false

# Largest dataset upload in bytes (default 25 MB). Raise for large JSONL files.
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=26214400

##################
# Admin accounts #
##################
# REQUIRED (at least one of the two options below).
#
# Option A: emails that are made admins when they sign up or log in, comma
# separated. Sign-up must be open (TOVA_ALLOW_SIGNUP=true) for these people to
# create their accounts in the first place.
TOVA_ADMIN_EMAILS=researcher@example.org
# Legacy alias, used only if TOVA_ADMIN_EMAILS is empty.
DJANGO_ADMIN_EMAILS=

# Option B: an admin account created from the command line, which works even
# with sign-up closed. After the stack is up, run:
#     docker compose exec web python manage.py sync_superuser
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

################
# LLM API keys #
################
# Optional. Leave empty to use only local / Ollama models.
OPENAI_API_KEY=

##############
# User study #
##############
# Whether anyone can create their own account. Set false while the study runs:
# participants should only use the logins the research team created, and a
# self-registered account bypasses the consent and task flow.
TOVA_ALLOW_SIGNUP=true

# Minutes participants get for the exploration task. The protocol specifies 30.
# A study group can override this in the admin.
STUDY_TASK_MINUTES=30

# Prolific only. The completion code from your Prolific study, shown to
# participants on the final page so they get paid. Leave empty for Upwork or
# moderated sessions.
PROLIFIC_COMPLETION_CODE=
# Prolific only, optional. The completion URL from Prolific, e.g.
# https://app.prolific.com/submissions/complete?cc=ABC123
PROLIFIC_RETURN_URL=

# Keep false during the study. Turns on a prototype active-learning interface
# at /active-learning-3 that is not one of the study conditions.
TOVA_ENABLE_AL3=false
